# Development Tools.
.mypy_cache/
.ruff_cache/
__pycache__/
.idea/
.vscode/

# Environments.
.venv*/
venv*/
conda_env*/

# Python Bytecode.
*.py[cod]

# Distribution/Packaging.
/build/
/dist/
*.egg-info/
.pypirc

# Operating System Junk.
*.DS_Store
Thumbs.db
desktop.ini

# IndexTTS.
/cache/
/checkpoints*/*
!/checkpoints*/*.yaml
/outputs/

# Example audio files (downloaded on demand, not stored in git)
/examples/*.wav
/tests/sample_prompt.wav

# Runtime state generated by the Pro console (user data, never committed).
# datasets/       imported audio + extracted .pt features (hundreds of MB)
# training_runs/  LoRA adapters + checkpoint vaults (tens of MB per run)
# voice_bank/     the user's own voice library
# All of them are recreated on demand, so a fresh clone stays small.
/datasets/
/training_runs/
/voice_bank/audio/
/voice_bank/index.json

.claude
.memsearch
